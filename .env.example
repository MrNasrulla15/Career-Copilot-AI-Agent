# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Google AI Studio ──────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Security Settings ──────────────────────────────────────────────────────
# Optional client API Key requirement for API routes (leave empty to disable)
APP_API_KEY=

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API Rate Limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# Debug Mode (set false for production security)
DEBUG=false

# ── Optional: Use Vertex AI instead of AI Studio ──────────────────────────
GOOGLE_GENAI_USE_VERTEXAI=false

# ── Model Configuration ────────────────────────────────────────────────────
MODEL_NAME=gemini-2.5-flash

# ── Application Settings ───────────────────────────────────────────────────
APP_NAME=career_copilot
LOG_LEVEL=INFO
